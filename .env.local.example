# ==============================================================
# Gainleadx Production & Automation Environment Variables
# ==============================================================

# 1. Sanity CMS Credentials (https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-05-01

# 2. Sanity API Tokens (Settings -> API -> Tokens)
# Read token for draft mode previews
SANITY_API_READ_TOKEN=your_sanity_read_token
# Editor/Write token for automated publishing pipeline (Permissions: Editor)
SANITY_API_WRITE_TOKEN=your_sanity_editor_write_token

# 3. AI Blog Automation Engine (Anthropic Claude 3.5 Sonnet)
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# 4. Ahrefs Keyword Research API (Optional)
# Get from https://ahrefs.com/api
AHREFS_API_KEY=your_ahrefs_api_key

# 5. Instant Cache Revalidation Secret
# Custom random string to secure your on-demand webhook
REVALIDATION_SECRET=gainleadx_revalidate_secret_key_2026
NEXT_PUBLIC_SITE_URL=https://gainleadx.com
